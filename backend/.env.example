# Server
PORT=8000

# Leave empty to use the persistent local MongoDB started by backend/start.js
DATABASE_URL=

# Replace this with a local secret before using authentication
TOKEN_SECRET=change-me-local-classroom-secret

# Frontend URL used for activation/reset links
BASE_URL=http://localhost:3000

# Optional Cloudinary image upload settings
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Optional email settings for verification/reset email delivery
EMAIL=
MAILING_ID=
MAILING_SECRET=
MAILING_REFRESH=
MAILING_ACCESS=# Copy to .env (created automatically by `npm run install:all`)

# Server
PORT=8000

# MongoDB. Leave empty to use the in-memory MongoDB started by backend/start.js
DATABASE_URL=

# JWT signing secret for login tokens
TOKEN_SECRET=change-me-local-classroom-secret

# Base URL of the frontend, used to build activation links
BASE_URL=http://localhost:3000

# Cloudinary (optional, only needed for image uploads)
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
